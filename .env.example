# The app runs with NO configuration. IBAN validation uses openIBAN (free,
# keyless) out of the box.
#
# OPTIONAL — broader IBAN coverage:
# openIBAN only returns bank/BIC data for a few EU countries (DE, NL, ...).
# To auto-fill BIC & bank for other countries, add a keyed global provider
# (ibanapi.com). The key is used server-side only.
#   - Get a key (with bank-data credits) at https://www.ibanapi.com/
#   - Local: copy this file to .env.local and set IBANAPI_KEY there (never here).
#   - Render/Vercel: add IBANAPI_KEY in the service's Environment settings.
# Leave the value blank here — .env.example IS committed to git.
IBANAPI_KEY=

# Optional endpoint overrides (rarely needed):
# OPENIBAN_URL=https://openiban.com/validate
# IBANAPI_URL=https://api.ibanapi.com/v1/validate
